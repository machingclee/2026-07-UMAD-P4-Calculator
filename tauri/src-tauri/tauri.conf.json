{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FF14 P4 Calculator",
  "version": "0.1.0",
  "identifier": "com.ff14.p4calculator",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FF14 P4 Calculator",
        "width": 420,
        "height": 220,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
